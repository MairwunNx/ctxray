{
  "name": "ctxray-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "#ctxray/*": "./packages/ctxray/src/*"
  },
  "scripts": {
    "check": "biome check . && tsc -p . && tsc -p tsconfig.client.json && bun scripts/check-file-size.ts",
    "fix": "biome check --write .",
    "typecheck": "tsc -p . && tsc -p tsconfig.client.json",
    "schemas": "bun scripts/gen-schemas.ts",
    "gitleaks": "bun scripts/gen-gitleaks.ts",
    "build": "bun scripts/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "typescript": "7.0.2"
  }
}
