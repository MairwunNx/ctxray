{
  "name": "ctxray-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "biome check . && tsc -p . && bun scripts/check-file-size.ts",
    "fix": "biome check --write .",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
