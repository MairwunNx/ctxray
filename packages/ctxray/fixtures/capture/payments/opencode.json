{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "local",
      "command": ["sh", "-c", "exec bun \"$(git rev-parse --show-toplevel)/mcp/server.ts\" github"]
    },
    "jira": {
      "type": "local",
      "command": ["sh", "-c", "exec bun \"$(git rev-parse --show-toplevel)/mcp/server.ts\" jira"]
    }
  }
}
