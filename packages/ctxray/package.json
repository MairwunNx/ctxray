{
  "name": "@mairwunnx/ctxray",
  "version": "0.1.0",
  "description": "X-ray for agent harnesses. See exactly what your Claude Code, Codex, Cursor & co. loaded – and test it in CI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MairwunNx/ctxray.git",
    "directory": "packages/ctxray"
  },
  "homepage": "https://github.com/MairwunNx/ctxray/wiki",
  "bugs": "https://github.com/MairwunNx/ctxray/issues",
  "engines": {
    "bun": ">=1.4.5"
  },
  "exports": {
    ".": "./src/app/public-api.ts"
  },
  "imports": {
    "#app/*": "./src/app/*",
    "#features/*": "./src/features/*",
    "#entities/*": "./src/entities/*",
    "#shared/*": "./src/shared/*",
    "#fixtures/*": "./fixtures/*",
    "#package.json": "./package.json"
  },
  "bin": {
    "ctxray": "./src/app/main.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "braces": "3.0.3",
    "elysia": "1.4.32",
    "gpt-tokenizer": "4.1.2",
    "ignore": "7.0.14",
    "ink": "8.0.0",
    "marked": "18.2.0",
    "p-map": "7.1.1",
    "react": "19.3.1",
    "typed-inject": "5.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/braces": "3.0.5",
    "@types/react": "19.3.0"
  }
}
